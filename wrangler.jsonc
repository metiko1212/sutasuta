{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kiray",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kiray-db",
      "database_id": "c4a9e7d4-897a-47cb-a4d3-350c78263f71",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "kiray-photos"
    }
  ],
  "vars": {
    "APP_NAME": "Kiray",
    "DEFAULT_LOCALE": "en"
  }
}
